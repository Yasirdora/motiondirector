{
  "name": "motion-director",
  "version": "0.1.0",
  "description": "An MCP server that lets AI understand motion in Adobe After Effects: it measures every curve, explains why motion feels the way it does, and directs changes safely.",
  "license": "MIT",
  "author": "Yasirdora",
  "type": "module",
  "bin": {
    "motion-director": "dist/src/index.js"
  },
  "main": "dist/src/index.js",
  "files": [
    "dist/src",
    "jsx",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test"
  },
  "keywords": [
    "after-effects",
    "motion-design",
    "mcp",
    "model-context-protocol",
    "animation",
    "extendscript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Yasirdora/motiondirector.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "acorn": "^8.18.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
